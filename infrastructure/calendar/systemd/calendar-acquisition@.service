[Unit]
Description=Saydin official calendar acquisition (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/saydin/calendar-acquisition.env
ExecStart=/opt/saydin/calendar/run-acquisition.sh %i
TimeoutStartSec=20min
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saydin/calendar /var/lock

[Install]
WantedBy=multi-user.target
