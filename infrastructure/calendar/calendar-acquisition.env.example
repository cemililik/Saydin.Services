SAYDIN_CALENDAR_IMAGE=registry.example.invalid/saydin-calendar-data@sha256:REPLACE_WITH_IMMUTABLE_DIGEST
SAYDIN_CALENDAR_BASE_BUNDLE=/var/lib/saydin/calendar/active-review-base
SAYDIN_CALENDAR_STAGING_ROOT=/var/lib/saydin/calendar/quarantine
SAYDIN_CALENDAR_TCMB_PLAN=/var/lib/saydin/calendar/plans/tcmb-daily.json
SAYDIN_CALENDAR_BIST_PLAN=/var/lib/saydin/calendar/plans/bist-yearly.json
SAYDIN_CALENDAR_LOCK_FILE=/var/lib/saydin/calendar/locks/acquisition.lock
SAYDIN_CALENDAR_RUNTIME_UID=1001
SAYDIN_CALENDAR_RUNTIME_GID=1001
SAYDIN_CALENDAR_VERIFY_CANDIDATE=/opt/saydin/calendar/verify-candidate.sh
SAYDIN_CALENDAR_REVIEWER_PUBLIC_KEY_SHA256=REPLACE_WITH_PINNED_LOWERCASE_SHA256
