# Paths only. Every directory is externally materialized 0700 and contains only
# the named consumer's 0400/0600 files. No credential value belongs in this file.
SAYDIN_RESTORE_BACKUP_SECRET_DIR=/absolute/restore/backup
SAYDIN_RESTORE_BOOTSTRAP_SECRET_DIR=/absolute/restore/bootstrap
# The bootstrap directory contains `admin-connection` and `admin-pgpass`; both
# target only the disposable `restored-db` alias.
SAYDIN_RESTORE_MIGRATOR_SECRET_DIR=/absolute/restore/migrator
SAYDIN_RESTORE_AUDIT_SECRET_DIR=/absolute/restore/audit
SAYDIN_RESTORE_AUDIT_INPUT_DIR=/absolute/restore/audit-input
SAYDIN_RESTORE_AUDIT_OUTPUT_DIR=/absolute/restore/audit-output
SAYDIN_RESTORE_API_SECRET_DIR=/absolute/restore/api
SAYDIN_RESTORE_API_CONFIG_FILE=/absolute/restore/api/appsettings.Production.json
SAYDIN_RESTORE_REDIS_SECRET_DIR=/absolute/restore/redis
SAYDIN_RESTORE_GEOIP_DIR=/absolute/restore/geoip
