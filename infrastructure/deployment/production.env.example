# This file contains identifiers and paths only. Copy it outside the repository,
# replace every CHANGE_ME value, chmod 0600, and never add secret values here.

SAYDIN_PUBLIC_HOST=api.example.invalid
SAYDIN_ACME_EMAIL=ops@example.invalid
SAYDIN_PROXY_NETWORK_CIDR=172.30.10.0/24
SAYDIN_BACKUP_DATABASE_NETWORK_CIDR=172.30.20.0/28
SAYDIN_DEPLOYMENT_ID=CHANGE_ME_DEPLOYMENT_ID
SAYDIN_RELEASE_VERSION=CHANGE_ME_RELEASE
SAYDIN_SERVICE_VERSION=CHANGE_ME_RELEASE
SAYDIN_GIT_SHA=CHANGE_ME_40_HEX_GIT_SHA
SAYDIN_DATABASE=saydin
SAYDIN_DATABASE_SYSTEM_IDENTIFIER_SHA256=CHANGE_ME_64_HEX_DATABASE_ID
SAYDIN_DATABASE_ROLE_PREFIX=CHANGE_ME_ROLE_PREFIX
SAYDIN_MIGRATOR_LOGIN=CHANGE_ME_MIGRATOR_LOGIN
SAYDIN_API_LOGIN=CHANGE_ME_API_LOGIN
SAYDIN_INGESTION_LOGIN=CHANGE_ME_INGESTION_LOGIN
SAYDIN_CALENDAR_IMPORTER_LOGIN=CHANGE_ME_CALENDAR_LOGIN
SAYDIN_EXPORTER_LOGIN=CHANGE_ME_EXPORTER_LOGIN
SAYDIN_AUDIT_LOGIN=CHANGE_ME_AUDIT_LOGIN
SAYDIN_BACKUP_LOGIN=CHANGE_ME_DEDICATED_REPLICATION_LOGIN
SAYDIN_BACKUP_V1_VALID_UNTIL=CHANGE_ME_RFC3339_UTC_SECOND_24H_TO_93D
SAYDIN_DQA_OCI_REGION=CHANGE_ME_OCI_REGION
SAYDIN_DQA_KMS_KEY_ID=CHANGE_ME_OCI_KMS_KEY_OCID
SAYDIN_DQA_KMS_KEY_VERSION_ID=CHANGE_ME_OCI_KMS_KEY_VERSION_OCID
SAYDIN_DQA_KMS_CRYPTO_ENDPOINT=https://CHANGE_ME_NAMESPACE-crypto.kms.CHANGE_ME_REGION.oraclecloud.com
SAYDIN_DQA_ALLOWED_EVIDENCE_KEY_IDS=CHANGE_ME_64_HEX_PUBLIC_KEY_FINGERPRINT
SAYDIN_CALENDAR_CODE=CHANGE_ME_tcmb_indicative_fx_OR_bist_pay_xist
SAYDIN_CALENDAR_RELEASE_ID=CHANGE_ME_UUID
SAYDIN_CALENDAR_RELEASE_VERSION=CHANGE_ME_POSITIVE_INTEGER
SAYDIN_CALENDAR_EXPECTED_CURRENT_RELEASE=CHANGE_ME_UUID
SAYDIN_GEOIP_DIRECTORY=/absolute/operator-owned/geoip

# Every image reference must be an immutable manifest-list digest. Tags are rejected.
SAYDIN_API_IMAGE=ghcr.io/OWNER/saydin-api@sha256:CHANGE_ME
SAYDIN_INGESTION_IMAGE=ghcr.io/OWNER/saydin-price-ingestion@sha256:CHANGE_ME
SAYDIN_CONTROL_IMAGE=ghcr.io/OWNER/saydin-database-control@sha256:CHANGE_ME
SAYDIN_CALENDAR_IMAGE=ghcr.io/OWNER/saydin-calendar@sha256:CHANGE_ME
SAYDIN_DQA_IMAGE=ghcr.io/OWNER/saydin-data-quality-audit@sha256:CHANGE_ME
SAYDIN_BACKUP_IMAGE=ghcr.io/OWNER/saydin-database-backup@sha256:CHANGE_ME
SAYDIN_TIMESCALE_IMAGE=timescale/timescaledb@sha256:CHANGE_ME
SAYDIN_REDIS_IMAGE=redis@sha256:CHANGE_ME
SAYDIN_CADDY_IMAGE=caddy@sha256:CHANGE_ME
SAYDIN_POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter@sha256:CHANGE_ME
SAYDIN_REDIS_EXPORTER_IMAGE=oliver006/redis_exporter@sha256:CHANGE_ME
SAYDIN_OTEL_IMAGE=otel/opentelemetry-collector-contrib@sha256:CHANGE_ME
SAYDIN_TEMPO_IMAGE=grafana/tempo@sha256:CHANGE_ME
SAYDIN_LOKI_IMAGE=grafana/loki@sha256:CHANGE_ME
SAYDIN_PROMETHEUS_IMAGE=prom/prometheus@sha256:CHANGE_ME
SAYDIN_ALERTMANAGER_IMAGE=prom/alertmanager@sha256:CHANGE_ME
SAYDIN_BLACKBOX_IMAGE=prom/blackbox-exporter@sha256:CHANGE_ME
SAYDIN_NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:CHANGE_ME

SAYDIN_POSTGRES_CPUS=2.0
SAYDIN_POSTGRES_MEMORY=4g
SAYDIN_REDIS_CPUS=1.0
SAYDIN_REDIS_MEMORY=1g
SAYDIN_API_CPUS=1.5
SAYDIN_API_MEMORY=1g
SAYDIN_INGESTION_CPUS=1.0
SAYDIN_INGESTION_MEMORY=1g
SAYDIN_CADDY_CPUS=0.5
SAYDIN_CADDY_MEMORY=256m
SAYDIN_JOB_CPUS=1.0
SAYDIN_JOB_MEMORY=1g
SAYDIN_EXPORTER_CPUS=0.25
SAYDIN_EXPORTER_MEMORY=256m
SAYDIN_OTEL_CPUS=0.5
SAYDIN_OTEL_MEMORY=512m
SAYDIN_TEMPO_CPUS=0.5
SAYDIN_TEMPO_MEMORY=1g
SAYDIN_TEMPO_RETENTION=720h
SAYDIN_LOKI_CPUS=0.5
SAYDIN_LOKI_MEMORY=1g
SAYDIN_LOKI_RETENTION=720h
SAYDIN_PROMETHEUS_CPUS=1.0
SAYDIN_PROMETHEUS_MEMORY=2g
SAYDIN_ALERTMANAGER_CPUS=0.25
SAYDIN_ALERTMANAGER_MEMORY=256m
SAYDIN_PROMETHEUS_RETENTION=30d

SAYDIN_BACKUP_BUCKET=CHANGE_ME_OFF_HOST_BUCKET
SAYDIN_BACKUP_KMS_KEY_ID=CHANGE_ME_KMS_KEY_OCID
SAYDIN_BACKUP_REPOSITORY=s3:https://CHANGE_ME_OBJECT_STORE_ENDPOINT/CHANGE_ME_BUCKET/saydin
SAYDIN_BACKUP_OBJECT_STORE_ROLE=CHANGE_ME_WORKLOAD_IDENTITY_ROLE
SAYDIN_BACKUP_REGION=CHANGE_ME_OBJECT_STORE_REGION

# All named volumes are pre-created by the deployment control plane. Secret
# volumes are private, per-consumer, and are never populated by this Compose file.
SAYDIN_POSTGRES_DATA_VOLUME=saydin_prod_postgres_data
SAYDIN_REDIS_DATA_VOLUME=saydin_prod_redis_data
SAYDIN_CADDY_DATA_VOLUME=saydin_prod_caddy_data
SAYDIN_CADDY_CONFIG_VOLUME=saydin_prod_caddy_config
