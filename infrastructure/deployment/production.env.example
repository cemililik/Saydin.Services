SAYDIN_ALERTMANAGER_SECRET_VOLUME=saydin_prod_alertmanager_secret
SAYDIN_AUDIT_SECRET_VOLUME=saydin_prod_audit_secret
SAYDIN_AUDIT_INPUT_VOLUME=saydin_prod_audit_input
