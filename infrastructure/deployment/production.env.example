SAYDIN_LOKI_DATA_VOLUME=saydin_prod_loki_data
SAYDIN_BACKUP_METRICS_VOLUME=saydin_prod_backup_metrics
SAYDIN_BACKUP_WAL_VOLUME=saydin_prod_backup_wal
SAYDIN_BLACKBOX_TARGETS_VOLUME=saydin_prod_blackbox_targets
