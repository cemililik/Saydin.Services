# The migration job is a deploy artifact: both the executable and the exact
# raw migration bytes used for checksum validation are baked into one image.
# tag: 10.0 (mcr.microsoft.com/dotnet/sdk)
FROM mcr.microsoft.com/dotnet/sdk@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c AS build
WORKDIR /app

COPY Directory.Build.props Directory.Packages.props ./
COPY src/Saydin.DatabaseSecurity/Saydin.DatabaseSecurity.csproj src/Saydin.DatabaseSecurity/
COPY src/Saydin.DatabaseMigrator/Saydin.DatabaseMigrator.csproj src/Saydin.DatabaseMigrator/
COPY src/Saydin.DatabaseRoleBootstrap/Saydin.DatabaseRoleBootstrap.csproj src/Saydin.DatabaseRoleBootstrap/
RUN dotnet restore src/Saydin.DatabaseMigrator/Saydin.DatabaseMigrator.csproj
RUN dotnet restore src/Saydin.DatabaseRoleBootstrap/Saydin.DatabaseRoleBootstrap.csproj

COPY src/Saydin.DatabaseSecurity/ src/Saydin.DatabaseSecurity/
COPY src/Saydin.DatabaseMigrator/ src/Saydin.DatabaseMigrator/
COPY src/Saydin.DatabaseRoleBootstrap/ src/Saydin.DatabaseRoleBootstrap/
RUN dotnet publish src/Saydin.DatabaseMigrator/Saydin.DatabaseMigrator.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish
RUN dotnet publish src/Saydin.DatabaseRoleBootstrap/Saydin.DatabaseRoleBootstrap.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

# tag: 10.0 (mcr.microsoft.com/dotnet/runtime)
FROM mcr.microsoft.com/dotnet/runtime@sha256:a365ce6a50b09176855d085c69da3fc1204a48432e36087e9a208f6e5860e235 AS runtime
WORKDIR /app

# Npgsql SCRAM/GSSAPI support; no psql/shell migration runner is used.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1001 -s /sbin/nologin appuser \
    && install -d -o appuser -g appuser -m 0700 /run/saydin-secrets

COPY --from=build --chown=appuser:appuser /app/publish/ ./
COPY --chown=appuser:appuser infrastructure/postgres/migrations/ /migrations/

USER appuser
ENV SAYDIN_MIGRATIONS_DIR=/migrations

ENTRYPOINT ["dotnet", "Saydin.DatabaseMigrator.dll"]
