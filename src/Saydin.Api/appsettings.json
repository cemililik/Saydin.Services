{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ApiRuntime": {
    "PublicPort": 8080,
    "ManagementPort": 9090
  },
  "ForwardedHeaders": {
    "KnownProxies": "127.0.0.1,::1",
    "KnownNetworks": "",
    "ForwardLimit": 1
  },
  "InstallationCredentials": {
    "SecretFile": "/run/saydin-secrets/private/installation-keyring.json",
    "ActiveKeyVersion": 1
  },
  "ActivityPrincipalPseudonym": {
    "SecretFile": "/run/saydin-secrets/private/activity-principal-hmac"
  },
  "DistributedSecurityLimiter": {
    "Enabled": true,
    "WindowSeconds": 60,
    "ExactIpLimit": 60,
    "NetworkLimit": 300,
    "PrincipalLimit": 120,
    "RegistrationExactHourlyLimit": 3,
    "RegistrationExactDailyLimit": 5,
    "RegistrationNetworkHourlyLimit": 20,
    "RegistrationNetworkDailyLimit": 100,
    "RegistrationIpv4ExactHourlyLimit": 60,
    "RegistrationIpv4NetworkHourlyLimit": 1000,
    "CalculationNetworkDailyLimit": 500,
    "HmacKeyFile": "/run/saydin-secrets/private/security-limiter-hmac",
    "RedisKeyPrefix": "security:rate:v1:"
  },
  "Plans": {
    "Free": {
      "DailyCalculationLimit": 20,
      "MaxSavedScenarios": 10,
      "Features": {
        "Comparison": true,
        "InflationAdjustment": true,
        "Share": true,
        "Dca": true,
        "PriceHistoryMonths": 12
      }
    },
    "Premium": {
      "DailyCalculationLimit": 0,
      "MaxSavedScenarios": 0,
      "Features": {
        "Comparison": true,
        "InflationAdjustment": true,
        "Share": true,
        "Dca": true,
        "PriceHistoryMonths": 0
      }
    }
  }
}
