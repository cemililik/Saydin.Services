# ============================================================
# Saydın — Ortam Değişkenleri Örneği
# Bu dosyayı kopyalayarak .env oluştur: cp .env.example .env
# .env asla git'e commit edilmez!
# ============================================================

# --- PostgreSQL (nonsecret topology only) ---
POSTGRES_DB=saydin
# DB parolaları .env'e yazılmaz. İlk çalıştırmada:
#   ./infrastructure/secrets/bootstrap-dev-database.sh
# Komut per-purpose owner-only secret volume'larını ve yalnız nonsecret metadata içeren
# `.env.database-runtime` dosyasını üretir. Runtime servisleri admin secret'ı mount etmez.

# --- Loopback development portları (ikinci Compose project için değiştirilebilir) ---
SAYDIN_POSTGRES_PORT=5432
SAYDIN_PGADMIN_PORT=5050
SAYDIN_REDIS_PORT=6379
SAYDIN_REDIS_INSIGHT_PORT=5540
SAYDIN_ASPIRE_PORT=18888
SAYDIN_OTLP_PORT=4317
SAYDIN_PROMETHEUS_PORT=9090
SAYDIN_API_PORT=5080
SAYDIN_INGESTION_HEARTBEAT_PATH=/tmp/saydin-ingestion-healthy

# --- pgAdmin (compose insecure default'u kaldırıldı; bu env zorunludur) ---
PGADMIN_EMAIL=admin@saydin.dev
PGADMIN_PASSWORD=change_me_in_production

# --- Redis ---
# F2.8-5: Redis requirepass — boş kabul edilmez (compose fail-fast).
REDIS_PASSWORD=change_me_in_production

# --- Dış API Key'leri (PriceIngestion) ---
# TCMB için API key gerekmez
COINGECKO_API_KEY=
OPENEXCHANGERATES_APP_ID=
TWELVEDATA_API_KEY=
EVDS_API_KEY=

# --- F4-7: MaxMind GeoLite2 (opsiyonel, best-effort coğrafi çözümleme) ---
# MMDB repoya commit EDİLMEZ (.gitignore *.mmdb). MaxMind hesabı açıp lisans key alın:
#   https://www.maxmind.com/en/geolite2/signup  →  Account ID + License Key
# İndirme talimatı: infrastructure/geoip/README.md. Yoksa GeoIP devre dışı kalır
# (LogWarning + country/city null) — istek başarısız OLMAZ. Detay: ADR-004.
GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- F2.8-7: .NET environment (prod deploy "Production"a getirir) ---
ASPNETCORE_ENVIRONMENT=Development

# --- Yalnız `devtools` profilindeki local Aspire Dashboard ---
ASPIRE_FRONTEND_AUTHMODE=Unsecured
ASPIRE_OTLP_AUTHMODE=Unsecured

# --- F2.8-6: PriceIngestion worker seçici aktivasyonu ---
# Free-tier external API limitleri için diğerleri default kapalı.
WORKER_TCMB_ENABLED=true
WORKER_COINGECKO_ENABLED=false
WORKER_OXR_ENABLED=false
WORKER_TWELVEDATA_ENABLED=false
WORKER_EVDS_ENABLED=true
