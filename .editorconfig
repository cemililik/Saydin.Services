# ============================================================
# Saydın Services — .editorconfig (Faz 3 / F3.1-1)
#
# Amaç: CLAUDE.md "İsimlendirme" kurallarını (I-prefix interface, _camelCase private
# field, PascalCase tip/metot) IDE seviyesinde görünür kılmak + temel format tutarlılığı.
#
# KAPSAM KARARI (review F3.1-1):
#   - XML doc comment zorunluluğu (CS1591) BİLİNÇLİ OLARAK kapalı. Directory.Build.props
#     TreatWarningsAsErrors=true; GenerateDocumentationFile + CS1591'i repo geneli açmak
#     mevcut kodu anında kırardı. Doc-comment backfill ayrı bir faza bırakıldı.
#   - Naming kuralları `suggestion` seviyesinde — EnforceCodeStyleInBuild set EDİLMEDİĞİ
#     için bunlar build'i kırmaz; yalnızca IDE ipucu olarak görünür (güvenli).
#   - "Async suffix" Roslyn'de yerleşik bir kural değildir; kod review ile denetlenir.
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.sql]
indent_size = 4

[*.cs]
# .NET kod stili — yalnız öneri (build'i kırmaz)
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_prefer_braces = when_multiline:silent

# ── İsimlendirme: Interface I-prefix ──────────────────────────────────────
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = any_interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = begins_with_i

dotnet_naming_symbols.any_interface.applicable_kinds = interface
dotnet_naming_symbols.any_interface.applicable_accessibilities = *

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# ── İsimlendirme: private instance field _camelCase ───────────────────────
dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = suggestion
dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_instance_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = underscore_camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers =

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# ── İsimlendirme: tip ve public üyeler PascalCase ─────────────────────────
dotnet_naming_rule.types_and_members_pascal.severity = suggestion
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_public_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case

dotnet_naming_symbols.types_and_public_members.applicable_kinds = class,struct,enum,property,method
dotnet_naming_symbols.types_and_public_members.applicable_accessibilities = public,internal,protected

dotnet_naming_style.pascal_case.capitalization = pascal_case
